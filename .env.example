# Copy to .env (gitignored, never commit it) and fill in real values.
# config/settings.py loads .env automatically via python-dotenv.

# Required only when EMBED_PROVIDER, LLM_PROVIDER, or JUDGE_LLM_PROVIDER is
# set to "openai" below.
OPENAI_API_KEY=

# Required only when a provider below is set to "openrouter" (chat only --
# never use it for EMBED_PROVIDER).
OPENROUTER_API_KEY= 

# --- Provider selection (all default to "ollama" -- omit to stay fully local/free) ---
# EMBED_PROVIDER=openai
# LLM_PROVIDER=openai
# JUDGE_LLM_PROVIDER=openai
# JUDGE_LLM_PROVIDER=openrouter

# Judge model -- must match the provider above. For openrouter, use the
# OpenRouter slug (openrouter.ai/models):
# JUDGE_LLM_MODEL=deepseek/deepseek-v4.1-flash

# Judge sampling temperature (default 0.0 = deterministic scoring):
# JUDGE_TEMPERATURE=0.0
