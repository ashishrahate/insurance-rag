# Copy to .env (gitignored, never commit it) and fill in real values.
# config/settings.py loads .env automatically via python-dotenv.

# Required only when EMBED_PROVIDER, LLM_PROVIDER, or JUDGE_LLM_PROVIDER is
# set to "openai" below.
OPENAI_API_KEY=

