# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Virtual environment
venv/
.venv/

# Environment / secrets
.env

# Scraped and derived data (folders kept via .gitkeep, contents ignored)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Local databases
*.db

# Run logs (append-only; copy them by hand when comparing hardware)
logs/*.jsonl

# Local Qdrant storage (only if bind-mounted into the repo)
qdrant_storage/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# md files
resume-star.md

# Private post-drafting material (not project docs, kept local only)
docs/linkedin-drafts/